# HTTP quick start: open http://YOUR_SERVER_IP:8080
PORT=8080
BIND_ADDRESS=0.0.0.0
PUBLIC_URL=
COOKIE_SECURE=false
NODE_ENV=development

# Set DOMAIN before using compose.https.yml. Its game service forces HTTPS settings.
DOMAIN=game.example.com

# Optional real-money Gem shop. Leave blank to keep purchases unavailable.
# Begin with Stripe TEST keys. Do not put keys in frontend JavaScript.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Automatic consistent snapshots: startup + every 6 hours, keep 28.
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=6
BACKUP_KEEP=28

# GitHub VPS runtime: clear this value when using existing Nginx/HTTPS.
COMPOSE_PROFILES=managed-tls
